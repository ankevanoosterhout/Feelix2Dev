{
  "name": "feelix",
  "productName": "Feelix",
  "version": "3.1.4",
  "main": "electron/main.js",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "rebuild": "electron-rebuild -f -w serialport",
    "watch": "ng build --watch --configuration development",
    "electron": "ng build && electron .",
    "ng:serve": "ng serve",
    "electron:serve-tsc": "tsc -p tsconfig-serve.json",
    "electron:serve": "wait-on http-get://localhost:4200/ && electron . --serve",
    "package-mac": "electron-packager . --overwrite --platform=darwin --asar --arch=x64 --icon=src/assets/icons/mac/icon.icns --prune --out=release-builds",
    "package-win": "electron-packager . feelix --overwrite --asar --platform=win32 --arch=x64 --icon=src/assets/icons/win/icon.ico --prune --out=release-builds --version-string.CompanyName=CE --version-string.FileDescription=CE --version-string.ProductName=\"Feelix\"",
    "package-linux": "electron-packager . feelix --overwrite --asar --platform=linux --arch=x64 --icon=src/assets/icons/png/512x512.png --prune --out=release-builds"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@tensorflow/tfjs": "^4.20.0",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.185.3",
    "@types/uuid": "^11.0.0",
    "@types/webgl2": "^0.0.6",
    "buffer": "^6.0.3",
    "clone": "^2.1.2",
    "closed-chain-ik": "^0.0.3",
    "d3": "^7.9.0",
    "d3-color": "^3.1.0",
    "drag-controls": "^1.0.4",
    "electron-browser-storage": "^1.0.7",
    "file-saver": "^2.0.5",
    "file-system": "^2.2.2",
    "jsonfile": "^6.1.0",
    "jszip": "^3.10.1",
    "max-listeners-exceeded-warning": "^0.0.1",
    "ngx-filesaver": "^20.0.0",
    "ngx-webstorage": "^21.0.1",
    "npm": "^11.19.0",
    "rxjs": "^7.8.1",
    "serialport": "^13.0.0",
    "three": "^0.185.1",
    "three-ik": "^0.1.0",
    "tslib": "^1.10.0",
    "urdf-loader": "^0.13.1",
    "uuid": "^14.0.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.2",
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/language-service": "^20.3.27",
    "@electron/rebuild": "^4.2.0",
    "@types/electron": "^1.6.12",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "^3.10.19",
    "@types/jasminewd2": "^2.0.8",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "electron": "^43.2.0",
    "electron-installer-dmg": "^4.0.0",
    "electron-packager": "^17.1.2",
    "electron-reload": "1.5.0",
    "electron-wix-msi": "^3.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "30.7.6",
    "eslint-plugin-prefer-arrow": "1.2.2",
    "jasmine-core": "~3.8.0",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "~6.4.2",
    "karma-chrome-launcher": "~2.2.0",
    "karma-coverage-istanbul-reporter": "^2.1.1",
    "karma-jasmine": "~2.0.1",
    "karma-jasmine-html-reporter": "^1.5.1",
    "protractor": "^7.0.0",
    "ts-node": "8.3.0",
    "tslint": "~6.1.3",
    "typescript": "^6.0.3",
    "wait-on": "3.3.0"
  }
}
